# Copy to .env and adjust for your machine. Do not commit the real .env.
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/revenueos
DB_USERNAME=revenueos
DB_PASSWORD=revenueos

# JWT — generate a real 256-bit base64 secret for anything beyond local dev
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLW1lLXJldmVudWVvcy1qd3Qtc2lnbmluZy1zZWNyZXQtMjU2Yml0
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# CORS — the frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080

# Email — set MAIL_ENABLED=true and point to any SMTP relay to actually send.
# Test by using @mailinator.com recipient addresses and reading them at mailinator.com.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@revenueos.dev
APP_BASE_URL=http://localhost:5173
